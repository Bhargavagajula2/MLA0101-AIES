
from collections import deque

def water_jug(cap1, cap2, target):
    queue = deque([(0, 0, [])])
    visited = set()

    while queue:
        a, b, path = queue.popleft()

        if (a, b) in visited:
            continue
        visited.add((a, b))

        path = path + [(a, b)]

        if a == target or b == target:
            return path

        # Fill jug 1
        next_states = [
            (cap1, b),
            (a, cap2),
            (0, b),
            (a, 0),
        ]

        # Pour jug 1 into jug 2
        pour = min(a, cap2 - b)
        next_states.append((a - pour, b + pour))

        # Pour jug 2 into jug 1
        pour = min(b, cap1 - a)
        next_states.append((a + pour, b - pour))

        for state in next_states:
            if state not in visited:
                queue.append((state[0], state[1], path))

    return None


# Jug capacities: 4 litres and 3 litres
path = water_jug(4, 3, 2)

if path:
    print("Sequence of states:")
    for state in path:
        print(state)
else:
    print("Goal cannot be reached")


